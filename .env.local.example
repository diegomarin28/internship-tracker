# Supabase - get these from your Supabase project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Resend - for sending emails (free tier: 3000 emails/month)
# Get at resend.com - sign up free
RESEND_API_KEY=re_your_key_here

# Your notification email
NOTIFICATION_EMAIL=diegomarinarnoletti@gmail.com

# Anthropic - for AI-powered job analysis (uses your existing Claude account)
# Get at console.anthropic.com > API Keys
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Cron secret - make up any random string to protect the cron endpoint
CRON_SECRET=make_up_any_random_string_here
